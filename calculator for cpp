#include<iostream>
using namespace std;
int main(){
    float num1, num2;
    char op;
    cout<<"Enter the first number:";
    cin>>num1;
    cout<<"Enter the operator(+, -, *, /): ";
    cin>>op;
    cout<<"Enter the second number:";
    cin>>num2;
    switch (op){
        case '+':
            cout<<"Summation of these number:" <<num1 + num2;
            break;
        case '-':
            cout<<"the subtract of these number:" <<num1 - num2;
            break;
        case '*':
            cout<<"multiply of these number:"<<num1 * num2;
            break;
        case '/':
            if(num2 != 0)
                cout<<"divided of these number:"<<num1 / num2;
            else
                cout<<"cannot divided by the zero";
                break;
        default:
            cout << "Invalid operator!";        


            


    }
    return 0;

}

#include<iostream>
using namespace std;
int main(){
    int n;
    long long fact = 1;
    cout<<"Enter a number:";
    cin>>n;
    if(n<1){
        cout<<"Factorial is not defined the negative number.";
    }else{
        for(int i = 1; i <= n; i++){
            fact = fact * i;
        }
        cout<<"Factorial of the number:"<< fact <<endl;   
    }
    return 0;
}

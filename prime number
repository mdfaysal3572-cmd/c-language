#include<iostream>
using namespace std;
int main(){
    int n;
    bool isprime = true;
    cout<<"Enter a number:";
    cin>> n;
    if(n<=1){
        isprime = false;
    }
    else{
        for(int i = 2; i<= n; i++){
            if(n % i == 0){
                isprime = false;
                break;
            }
        }
    }
    if (isprime){
        cout<<"the number is prime"<<n<<endl;
    }else{
        cout<<"the number is not prime"<<n<<endl;
    }
return 0; 
}
